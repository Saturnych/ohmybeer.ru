---
import siteData from '$/data/site.json';
import Layout from '$/layouts/Layout.astro';

const header = `На кранах`;
const title = `${header} || ${siteData.name}`;

//console.log('taps:', taps);
---

<Layout title={title}>
	<section class="menu section section--alt" aria-labelledby="taps-title" id="taps">
		<div class="container container--narrow">
			<h2 id="taps-title" class="section__title">{header}</h2>
		</div>
		<div><input type="file" id="input" /></div>
	</section>
</Layout>

<script>
	import readXlsxFile from 'read-excel-file';

	const input = document.getElementById('input');

	input.addEventListener('change', async (event) => {
		const file = event.target.files[0];
		const data = await readXlsxFile(file);
		console.log(data);
	});
</script>

<style>
	.menu__categories {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-6);
	}

	.menu__category {
		background-color: var(--color-bg-deep);
		border: 1px solid rgba(201, 162, 39, 0.15);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.menu__category-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: var(--space-4) var(--space-5);
		background: transparent;
		border: none;
		cursor: pointer;
		text-align: left;
		transition: background-color var(--transition-fast);
	}

	.menu__category-header:hover {
		background-color: rgba(201, 162, 39, 0.05);
	}

	.menu__category-header:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: -2px;
	}

	.menu__category-title {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--color-primary);
		margin: 0;
		letter-spacing: 0.05em;
	}

	.menu__toggle {
		position: relative;
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}

	.menu__toggle-bar {
		position: absolute;
		width: 100%;
		height: 2px;
		background-color: var(--color-primary);
		top: 50%;
		left: 0;
		transition: transform var(--transition-fast);
	}

	.menu__toggle-bar:first-child {
		transform: translateY(-50%);
	}

	.menu__toggle-bar:last-child {
		transform: translateY(-50%) rotate(90deg);
	}

	.menu__category-header[aria-expanded='true'] .menu__toggle-bar:last-child {
		transform: translateY(-50%) rotate(0);
	}

	.menu__panel {
		overflow: hidden;
		transition:
			max-height var(--transition-normal),
			opacity var(--transition-normal);
		max-height: 500px;
		opacity: 1;
	}

	.menu__panel[aria-hidden='true'] {
		max-height: 0;
		opacity: 0;
	}

	.menu__items {
		list-style: none;
		padding: 0 var(--space-5) var(--space-5);
		margin: 0;
	}

	.menu__item {
		padding: var(--space-3) 0;
		border-bottom: 1px solid rgba(232, 228, 220, 0.08);
	}

	.menu__item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.menu__item-header {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin-bottom: var(--space-1);
	}

	.menu__item-name {
		font-weight: 600;
		color: var(--color-secondary);
	}

	.menu__item a {
		color: var(--color-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.menu__item a:hover {
		color: var(--color-secondary);
	}

	.menu__item a:focus-visible {
		outline: 2px solid var(--color-secondary);
		outline-offset: 2px;
	}

	.menu__item-desc {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 640px) {
		.menu__categories {
			grid-template-columns: 1fr;
		}

		.menu__category-title {
			font-size: var(--text-lg);
		}
	}
</style>

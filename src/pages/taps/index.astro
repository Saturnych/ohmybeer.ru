---
import { getCollection } from 'astro:content';
import { getPriceTableData } from '$/lib/price';
import { searchTaps } from '$/lib/untappd';
import { dateToIntlFormat, hashWithTextEncoder, saveJsonFile } from '$/lib/utils';
import siteData from '$/data/site.json';
import Layout from '$/layouts/Layout.astro';

const { DEV } = import.meta.env;
console.log('');

const header = `На кранах`;
const title = `${header} || ${siteData.name}`;

let { taps, updatedAt }: { taps: any[]; updatedAt: string } = await getPriceTableData();

if (taps?.length < 1) {
	const tapsCollection: Record<string, any>[] = await getCollection('taps');
	if (tapsCollection?.length > 0) {
		taps = tapsCollection.map((item) => {
			const { id, data } = item;
			return {
				...data,
				id,
			};
		});
	}
}

const search: Record<string, any[]> = ({
	results: [],
	taps: [],
} = await searchTaps(taps));
if (search?.taps?.length > 0) {
	console.log(`\nsearch search.taps.length:`, search.taps.length);
	saveJsonFile(search?.taps, './src/data/search.json');
	taps = taps.map((tap) => {
		let { beer, brewery, hash } = tap;
		if (!hash) hash = hashWithTextEncoder(`${brewery ? brewery + ' ' : ''}${beer}`);
		const foundTap = search.taps.find((tap) => tap.hash === hash);
		//if (DEV) console.log(`\nsearch foundTap:`, foundTap?.beer_slug, foundTap?.hash);
		return foundTap ? Object.assign(tap, foundTap) : tap;
	});
}
if (taps?.length > 0) {
	saveJsonFile(taps, './src/data/taps.json');
}

updatedAt = taps.length > 0 ? dateToIntlFormat(taps[0].updatedAt) : '';
console.log('updatedAt:', updatedAt);
console.log('taps.length:', taps.length);
//console.log('taps:', taps);
---

<Layout title={title}>
	<section class="menu section section--alt" aria-labelledby="taps-title" id="taps">
		<div class="container container--narrow">
			<h2 id="taps-title" class="section__title">{header}</h2>
			<div class="menu__category-header">
				<h4 class="menu__category-title">Обновлено: {updatedAt}</h4>
			</div>

			<ul class="menu__items" role="list">
				{
					taps.map((item) => (
						<li class="menu__item">
							<div class="menu__item-header">
								<a href={`/beers/${item.beer_slug}/`}>
									<span class="menu__item-name">
										{`${item.tap}. `}
										{`${!!item.brewery_name && item.brewery_name?.length < 20 && !!item.brewery ? item.brewery_name : !!item.brewery ? item.brewery : '⟡'} -`}
									</span>
									<span class="menu__item-name">
										{!!item.beer_name && item.beer_name?.length < 30 ? item.beer_name : item.beer}
									</span>
								</a>
								<span class="badge badge--seasonal">{item.beer_style || item.style || '★'}</span>
								{!!item.beer_abv && (
									<span class={`badge badge--featured`}>ABV: {item.beer_abv}</span>
								)}
								{!!item.beer_ibu && (
									<span class={`badge badge--seasonal`}>IBU:{item.beer_ibu}</span>
								)}
								<a href={`/beers/${item.beer_slug}/`}>
									<span class="badge"> &gt; </span>
								</a>
							</div>
							{item.desc && <p class="menu__item-desc">{item.desc}</p>}
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.menu__categories {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-6);
	}

	.menu__category {
		background-color: var(--color-bg-deep);
		border: 1px solid rgba(201, 162, 39, 0.15);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.menu__category-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: var(--space-4) var(--space-5);
		background: transparent;
		border: none;
		cursor: pointer;
		text-align: left;
		transition: background-color var(--transition-fast);
	}

	.menu__category-header:hover {
		background-color: rgba(201, 162, 39, 0.05);
	}

	.menu__category-header:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: -2px;
	}

	.menu__category-title {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--color-primary);
		margin: 0;
		letter-spacing: 0.05em;
	}

	.menu__toggle {
		position: relative;
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}

	.menu__toggle-bar {
		position: absolute;
		width: 100%;
		height: 2px;
		background-color: var(--color-primary);
		top: 50%;
		left: 0;
		transition: transform var(--transition-fast);
	}

	.menu__toggle-bar:first-child {
		transform: translateY(-50%);
	}

	.menu__toggle-bar:last-child {
		transform: translateY(-50%) rotate(90deg);
	}

	.menu__category-header[aria-expanded='true'] .menu__toggle-bar:last-child {
		transform: translateY(-50%) rotate(0);
	}

	.menu__panel {
		overflow: hidden;
		transition:
			max-height var(--transition-normal),
			opacity var(--transition-normal);
		max-height: 500px;
		opacity: 1;
	}

	.menu__panel[aria-hidden='true'] {
		max-height: 0;
		opacity: 0;
	}

	.menu__items {
		list-style: none;
		padding: 0 var(--space-5) var(--space-5);
		margin: 0;
	}

	.menu__item {
		padding: var(--space-3) 0;
		border-bottom: 1px solid rgba(232, 228, 220, 0.08);
	}

	.menu__item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.menu__item-header {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin-bottom: var(--space-1);
	}

	.menu__item-name {
		font-weight: 600;
		color: var(--color-secondary);
	}

	.menu__item a {
		color: var(--color-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.menu__item a:hover {
		color: var(--color-secondary);
	}

	.menu__item a:focus-visible {
		outline: 2px solid var(--color-secondary);
		outline-offset: 2px;
	}

	.menu__item-desc {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	@media (max-width: 640px) {
		.menu__categories {
			grid-template-columns: 1fr;
		}

		.menu__category-title {
			font-size: var(--text-lg);
		}
	}
</style>

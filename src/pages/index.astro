---
import { getTable } from '$/lib/cheerio';
import Head from '$/components/Head.astro';
import pkg from '$/lib/pkg';

const { title, description } = pkg;
const { DEV, PRIVATE_PRICE_URL } = import.meta.env;

console.log('');
console.log('title:', title);
console.log('PRIVATE_PRICE_URL.length:', PRIVATE_PRICE_URL?.length);

let table: string = '';

if (PRIVATE_PRICE_URL?.length > 0) {
	const fetched: any = await fetch(PRIVATE_PRICE_URL);
	const remote: string = await fetched.text();
	table = getTable(remote);
}

console.log('table.length:', table?.length);
---

<html lang="en">
	<Head title={title} description={description} />
	<body>
		<h1>{title}</h1>
    <div id="main" set:html={table}></div>
	</body>
</html>

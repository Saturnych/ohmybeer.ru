---
import Layout from '$/layouts/Layout.astro';
import Navbar from '$/components/Navbar.astro';
import Header from '$/components/Header.astro';
import InfoBar from '$/components/InfoBar.astro';
import Tagline from '$/components/Tagline.astro';
import Taps from '$/components/Taps.astro';
import Location from '$/components/Location.astro';
import Contact from '$/components/Contact.astro';
import Footer from '$/components/Footer.astro';
---

<Layout>
	<Navbar />
	<Header />
	<InfoBar />

	<main id="main-content">
		<Tagline />
		<Taps />
		<Location />
		<Contact />
	</main>

	<Footer />
</Layout>

<style is:global>
	/* Page-level scroll margin for section anchors */
	/* Account for sticky navbar (60px) */
	section[id] {
		scroll-margin-top: 120px;
	}

	/* Mobile: account for bottom bar and navbar */
	@media (max-width: 640px) {
		section[id] {
			scroll-margin-top: 80px;
		}
	}
</style>

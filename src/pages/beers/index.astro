---
import Layout from '$/layouts/Layout.astro';
import Error from '$/components/Error.astro';
import siteData from '$/data/site.json';

const header = `404 - Not Found`;
const title = `${header} || ${siteData.name}`;
const description = `Страница не найдена`;
const fullDescription = `Извините, страница, которую вы ищете, не найдена.`;
---

<Layout title={title} description={description} redirect={'/'}>
	<Error header={header} description={description} fullDescription={fullDescription} />
</Layout>

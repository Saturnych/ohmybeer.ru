---
import { getCollection, getEntry } from 'astro:content';
import siteData from '$/data/site.json';
import Layout from '$/layouts/Layout.astro';

export const getStaticPaths = async () => {
	const beersCollection = await getCollection('beers');
	const beers: Record<string, any>[] = beersCollection.map((item) => item.data);
	return beers.map((item) => ({ params: { slug: item.beer_slug } }));
};

const beerCollection = await getEntry('beers', Astro.params.slug);
const beer: Record<string, any> = beerCollection.data;
const breweryCollection = await getEntry('breweries', beer.brewery.id);
const brewery: Record<string, any> = breweryCollection.data;
//console.log(`\nbrewery:`, brewery?.brewery_name);
//console.log(`beer:`, beer?.beer_name);

let taps: Record<string, any>[] = [];
const tapsCollection: Record<string, any>[] = await getCollection('taps');
if (tapsCollection?.length > 0) {
	taps = tapsCollection.map((item) => {
		const { id, data } = item;
		return {
			...data,
			id,
		};
	});
}

const tap = taps.find((tap) => tap.beer_slug === beer.beer_slug);
console.log(`beer:`, beer);

const header = `Пиво и сидры`;
const title = `${brewery.brewery_name} - ${beer.beer_name} || ${header} || ${siteData.name}`;
const description = `${brewery.brewery_name} - ${beer.beer_name}: ${beer.beer_description}`;

---

<Layout title={title} description={description} image={beer.beer_label}>
	<section class="articles section" aria-labelledby="articles-title">
		<div class="container">
			<h2 id="articles-title" class="section__title">{header}</h2>
			<div class="article-card__content">
				<h3 class="article-card__title">
					{brewery.brewery_name} - {beer.beer_name}
				</h3>
				{!!beer.beer_description && <p class="article-card__excerpt" set:html={beer.beer_description ? beer.beer_description.replace(/[\n]+/g, '<br />').trim() : ''}></p>}
				<div class="articles__grid">
    				<div>
                        <span class="badge badge--featured">Чекинов в UNTAPPD: {beer.checkin_count}</span>
    				</div>
    				<div>
						<span class="badge badge--seasonal">{beer.beer_style || beer.style || '★'}</span>
					</div>
					<div>
						{!!beer.beer_abv && <span class={`badge badge--featured`}>ABV: {beer.beer_abv}</span>}
					</div>
					<div>
						{!!beer.beer_ibu && <span class={`badge badge--seasonal`}>IBU:{beer.beer_ibu}</span>}
					</div>
					<div>
					    {!!tap?.price && <span class="badge">{Math.round(tap.price / 2) + ' ₽'}</span>}
					</div>
				</div>
				<div class="article-card__link">
                    <a href={`/taps/`} class="article-card__read-more">
                        <span class="article-card__arrow" aria-hidden="true">&lt;-</span>
                        Назад
                    </a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.articles__grid {
		display: grid;
		grid-template-columns: 1fr);
		gap: var(--space-2);
		margin-top: var(--space-2);
	}

	.articles__empty {
		text-align: center;
		padding: var(--space-16) var(--space-4);
	}

	.articles__empty-text {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		font-style: italic;
	}

	@media (max-width: 768px) {
		.articles__grid {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}
	}

	@media (max-width: 640px) {
		.articles__grid {
			gap: var(--space-4);
		}
	}

	.article-card {
		display: flex;
		flex-direction: column;
		background-color: var(--color-bg-mid);
		border-radius: var(--radius-md);
		overflow: hidden;
		transition:
			transform var(--transition-normal),
			box-shadow var(--transition-normal);
	}

	.article-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-medium);
	}

	.article-card__image-link {
		display: block;
		overflow: hidden;
		line-height: 0;
	}

	.article-card__image {
		width: 50%;
		height: 100px;
		object-fit: cover;
		transition: transform var(--transition-slow);
	}

	.article-card:hover .article-card__image {
		transform: scale(1.05);
	}

	.article-card__content {
		padding: var(--space-6);
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.article-card__date {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: var(--space-3);
	}

	.article-card__title {
		font-size: var(--text-xl);
		margin-bottom: var(--space-2);
		line-height: var(--leading-tight);
	}

	.article-card__link {
		color: var(--color-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
		margin-top: var(--space-4);
	}

	.article-card__link:hover {
		color: var(--color-primary);
	}

	.article-card__link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.article-card__excerpt {
		color: var(--color-text);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--space-4);
		flex: 1;
	}

	.article-card__author {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-bottom: var(--space-4);
		font-style: italic;
	}

	.article-card__read-more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-primary);
		text-decoration: none;
		transition:
			gap var(--transition-fast),
			color var(--transition-fast);
		align-self: flex-start;
	}

	.article-card__read-more:hover {
		gap: var(--space-3);
		color: var(--color-secondary);
	}

	.article-card__read-more:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.article-card__arrow {
		transition: transform var(--transition-fast);
	}

	.article-card__read-more:hover .article-card__arrow {
		transform: translateX(4px);
	}

	@media (max-width: 640px) {
		.article-card__content {
			padding: var(--space-4);
		}

		.article-card__title {
			font-size: var(--text-lg);
		}

		.article-card__image {
			height: 180px;
		}
	}
</style>

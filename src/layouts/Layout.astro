---
import '$/styles/global.css';
import siteData from '$/data/site.json';
import pkg from '$/lib/pkg';
import Navbar from '$/components/Navbar.astro';
import Footer from '$/components/Footer.astro';

const { author } = pkg;

interface Props {
	name?: string;
	title?: string;
	description?: string;
	lang?: string;
	redirect?: string;
}

const {
	name = siteData.name,
	title = siteData.seo.metaTitle,
	description = siteData.seo.metaDescription,
	lang = 'ru',
	redirect,
} = Astro.props;

// Build LocalBusiness structured data
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	name: siteData.name,
	description: description,
	url: Astro.url.origin,
	phone: siteData.phone,
	email: siteData.email,
	address: {
		'@type': 'PostalAddress',
		streetAddress: siteData.address.full.split(',')[0],
		addressLocality: 'Нагорный р-н',
		addressRegion: 'Москва',
		postalCode: siteData.address.full.match(/\d{5}/)?.[0] || '',
		addressCountry: 'RU',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: siteData.coordinates.lat,
		longitude: siteData.coordinates.lng,
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '23:00',
		},
	],
	priceRange: '$$',
	servesCuisine: 'Bar',
	image: `${Astro.url.origin}/assets/logo.png`,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />

		{!!redirect && <meta http-equiv="refresh" content={`0; URL='${redirect}'`} />}

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Theme Color -->
		<meta name="theme-color" content="#1a1a18" />
		<meta name="msapplication-TileColor" content="#1a1a18" />
		<meta name="msapplication-TileImage" content="/assets/ms-icon-144x144.png" />

		<!-- Favicon & manifest -->
		<link rel="apple-touch-icon" sizes="57x57" href="/assets/apple-icon-57x57.png" />
		<link rel="apple-touch-icon" sizes="60x60" href="/assets/apple-icon-60x60.png" />
		<link rel="apple-touch-icon" sizes="72x72" href="/assets/apple-icon-72x72.png" />
		<link rel="apple-touch-icon" sizes="76x76" href="/assets/apple-icon-76x76.png" />
		<link rel="apple-touch-icon" sizes="114x114" href="/assets/apple-icon-114x114.png" />
		<link rel="apple-touch-icon" sizes="120x120" href="/assets/apple-icon-120x120.png" />
		<link rel="apple-touch-icon" sizes="144x144" href="/assets/apple-icon-144x144.png" />
		<link rel="apple-touch-icon" sizes="152x152" href="/assets/apple-icon-152x152.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-icon-180x180.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/assets/android-icon-192x192.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
		<link rel="icon" type="image/x-icon" sizes="16x16" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={Astro.url} />

		<!-- Fonts - Google Fonts with display=swap for performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Source+Sans+3:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${Astro.url.origin}/assets/logo.png`} />
		<meta property="og:locale" content="ru_RU" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${Astro.url.origin}/assets/logo.png`} />

		<!-- Additional SEO -->
		<meta name="robots" content="index, follow" />
		<meta name="author" content={author?.name || siteData.author} />
		<meta name="generator" content={Astro.generator} />

		<!-- Structured Data / JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a href="#main-content" class="sr-only">На главную</a>
		<Navbar />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	/* Critical inline styles for above-the-fold content */
	html {
		scroll-padding-top: 60px;
	}

	/* Ensure smooth scroll for anchor links */
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	/* Page-level scroll margin for section anchors */
	/* Account for sticky navbar (60px) */
	section[id] {
		scroll-margin-top: 120px;
	}

	/* Mobile: account for bottom bar and navbar */
	@media (max-width: 640px) {
		section[id] {
			scroll-margin-top: 80px;
		}
	}
</style>
